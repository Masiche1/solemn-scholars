# --- Build-time -------------------------------------------------------------
# Fastify backend origin that /api/v1/* is proxied to. REQUIRED for production
# builds (it is baked into the rewrite at build time). No trailing slash.
API_URL=http://localhost:4310

# --- Public (exposed to the browser) ----------------------------------------
# Canonical site URL: used for metadataBase, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enables the mock "x-dev-user" auth header + role switcher. Always on outside
# production; leave UNSET (or false) in real production. Only set to "true" for a
# staging deployment talking to a mock-auth backend.
NEXT_PUBLIC_DEV_AUTH=false
